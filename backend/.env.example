# DocVault Backend Environment Configuration

# Server Port & Environment
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/docvault?retryWrites=true&w=majority

# Groq Cloud API (Llama 3.3 / Qwen / Llama 3.2 Vision OCR & Semantic Extraction)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Hugging Face API (Embeddings & Semantic Vector generation)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cloudflare R2 Object Storage (S3-compatible secure external vault storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# Firebase / Google Cloud Storage Service Account (Alternative Storage Option)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app

# JWT Secret for Session Authentication & PIN Unlock
JWT_SECRET=your_super_secret_jwt_key_here

